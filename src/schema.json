{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missinglayer.dev/schemas/shiplayer/v1.json",
  "title": "ShipLayer release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "app", "contacts", "metadata", "permissions", "dataProcessing", "externalProcessors", "review", "screenshots", "monetization", "build", "sync", "confirmations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "app": { "type": "object", "additionalProperties": false, "required": ["name", "bundleId", "deviceFamilies", "locales", "primaryLocale", "availability", "releaseMode"], "properties": {
      "name": { "type": "string", "minLength": 1 }, "bundleId": { "type": "string", "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$" }, "appleTeamId": { "type": "string" }, "appStoreAppId": { "type": "string" }, "sku": { "type": "string" }, "version": { "type": "string" }, "build": { "type": "string" }, "deploymentTarget": { "type": "string" }, "deviceFamilies": { "type": "array", "minItems": 1, "items": { "enum": ["iphone", "ipad"] }, "uniqueItems": true }, "locales": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }, "primaryLocale": { "type": "string" }, "primaryCategory": { "type": "string" }, "secondaryCategory": { "type": "string" }, "availability": { "enum": ["all", "selected"] }, "releaseMode": { "enum": ["manual", "automatic", "scheduled"] }
    }},
    "contacts": { "type": "object" }, "metadata": { "type": "object", "required": ["localizations"], "properties": { "localizations": { "type": "object" } } }, "permissions": { "type": "array" }, "dataProcessing": { "type": "array" }, "externalProcessors": { "type": "array" }, "review": { "type": "object", "required": ["recordingScenarios"], "properties": { "recordingScenarios": { "type": "array" } } }, "screenshots": { "type": "object", "required": ["scenarios", "configurations", "rawOutputDir"], "properties": { "scenarios": { "type": "array" }, "configurations": { "type": "array" }, "rawOutputDir": { "type": "string" } } },
    "monetization": { "oneOf": [ { "type": "object", "required": ["type"], "properties": { "type": { "const": "free" } } }, { "type": "object", "required": ["type", "pricePointReference"], "properties": { "type": { "const": "paid-app" }, "pricePointReference": { "type": "string" } } }, { "type": "object", "required": ["type", "products"], "properties": { "type": { "const": "non-consumables" }, "products": { "type": "array" } } }, { "type": "object", "required": ["type", "group", "baseTerritory", "products", "paywallNavigation", "restorePath", "confirmation"], "properties": { "type": { "const": "subscriptions" }, "group": { "type": "object" }, "baseTerritory": { "type": "string" }, "products": { "type": "array" }, "paywallNavigation": { "type": "string" }, "restorePath": { "type": "string" }, "confirmation": { "enum": ["confirmed", "needs-human-confirmation", "not-applicable"] } } } ] },
    "build": { "type": "object", "required": ["signing"], "properties": { "signing": { "enum": ["automatic", "manual", "unknown"] } } }, "sync": { "type": "object", "required": ["mode"], "properties": { "mode": { "enum": ["dry-run", "apply"] } } }, "confirmations": { "type": "object", "required": ["privacy", "legal", "trader", "paidAgreements"], "properties": { "privacy": { "enum": ["confirmed", "needs-human-confirmation", "not-applicable"] }, "legal": { "enum": ["confirmed", "needs-human-confirmation", "not-applicable"] }, "trader": { "enum": ["confirmed", "needs-human-confirmation", "not-applicable"] }, "paidAgreements": { "enum": ["confirmed", "needs-human-confirmation", "not-applicable"] } } }
  }
}
