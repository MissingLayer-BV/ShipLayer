# References only. Never put Apple private key material in shiplayer.yml.
APPLE_TEAM_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
# Absolute path to the .p8 key. ShipLayer never prints its contents.
APP_STORE_CONNECT_PRIVATE_KEY_PATH=
# Complete Google service-account JSON. Prefer a protected CI environment secret.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
